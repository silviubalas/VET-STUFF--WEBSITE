# =============================================================================
# VET STUFF — website / API (Vercel Serverless)
# Copiază valorile în Vercel → Project Settings → Environment Variables.
# NU comite un .env real cu secrete. Acesta e doar template documentar.
# Legendă:  [OBLIGATORIU] fără el pică funcția  ·  [OPȚIONAL] are fallback/skip
# =============================================================================

# --- Supabase (booking, chat, lead-security, conturi client) -----------------
SUPABASE_URL=                       # [OBLIGATORIU] ex: https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # [OBLIGATORIU] service role (server-only, NU în browser)
SUPABASE_ANON_KEY=                  # [OBLIGATORIU] anon key (expus în /api/public-config)
# Aliasuri acceptate ca fallback (dacă le folosești deja): VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, SUPABASE_SERVICE_KEY
CLINIC_ID=                          # [OPȚIONAL] UUID clinică; default 00000000-0000-0000-0000-000000000001

# --- STUFFIE chatbot (gateway website → n8n brain) ---------------------------
INTERNAL_API_TOKEN=                 # [OBLIGATORIU] token intern cerut de n8n (x-internal-token)
STUFFIE_BRAIN_URL=                  # [OPȚIONAL] default https://stuffie.vet-stuff.ro/webhook/stuffie-brain

# --- Anti-abuz lead-uri ------------------------------------------------------
LEAD_SECURITY_PEPPER=               # [OBLIGATORIU*] pepper HMAC pt hash-uri; fallback pe INTERNAL_API_TOKEN / service role

# --- Cloudflare Turnstile (captcha) ------------------------------------------
TURNSTILE_SITE_KEY=                 # [OBLIGATORIU în prod] cheie publică (frontend)
TURNSTILE_SECRET_KEY=               # [OBLIGATORIU în prod] cheie secretă (verificare server)
REQUIRE_TURNSTILE=1                 # [OBLIGATORIU în prod] =1 obligă captcha; altfel se sare silențios!
TURNSTILE_SESSION_SECRET=           # [OPȚIONAL] semnare sesiuni; fallback INTERNAL_API_TOKEN / TURNSTILE_SECRET_KEY
TURNSTILE_SESSION_TTL_SECONDS=      # [OPȚIONAL] default 1800 (30 min)

# --- Airtable (programări, newsletter, feedback, contact, abonamente) --------
AIRTABLE_TOKEN=                     # [OBLIGATORIU pt formulare/abonamente] token API Airtable

# --- Notificări email (Resend) ----------------------------------------------
RESEND_API_KEY=                     # [OBLIGATORIU pt email clinică/abonament] cheie Resend
CLINIC_NOTIFY_EMAIL=                # [OPȚIONAL] default vet.stuff@yahoo.com
FORMSPREE_ENDPOINT=                 # [OPȚIONAL] default https://formspree.io/f/mzdkbdzb

# --- SMS (SMSlink.ro) — !! LIPSESC ÎN VERCEL, SMS-ul e dezactivat silențios --
SMSLINK_USER=                       # [OBLIGATORIU pt SMS] connection_id SMSlink
SMSLINK_PASSWORD=                   # [OBLIGATORIU pt SMS] password SMSlink
SMS_SENDER_ID=                      # [OPȚIONAL] sender aprobat; gol = număr scurt default

# --- Abonamente: activare la vizită (u.html + PIN medic) ---------------------
VET_PIN=                            # [OBLIGATORIU pt /api/use-service] PIN medic (server-only)

# --- Conturi client (booking logat) -----------------------------------------
BOOKING_TOKEN_SECRET=               # [OPȚIONAL] semnare token cont; fallback service role
CLIENT_ACCOUNT_RESET_REDIRECT_URL=  # [OPȚIONAL] default https://www.vet-stuff.ro/reset-parola.html
CLIENT_ACCOUNT_INVITE_REDIRECT_URL= # [OPȚIONAL] redirect invitație cont

# --- e-Factura (callback CRM) ------------------------------------------------
EFACTURA_CRM_BASE=                  # [OPȚIONAL] base URL CRM pt callback
EFACTURA_CLIENT_SECRET=             # [OPȚIONAL] secret validare callback
EFACTURA_CALLBACK_URL=              # [OPȚIONAL] URL callback

# --- Diverse -----------------------------------------------------------------
ALLOWED_ORIGINS=                    # [OPȚIONAL] origini extra permise, separate prin virgulă
ALLOW_PUBLIC_NOTIFICATION_ENDPOINTS=# [OPȚIONAL] =1 deschide endpoint-urile interne (NU în prod)
SHOW_DEMO_DOCTORS=                  # [OPȚIONAL] =1 arată medicii demo în booking
